# StudyPilot Server Environment Configuration
PORT=3001
NODE_ENV=development

# AI Provider Selection: 'demo', 'gemini', 'openai', 'groq', 'anthropic', 'ollama'
# If no provider API key is provided, StudyPilot automatically runs in Demo Mode.
AI_PROVIDER=demo

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local Ollama Configuration (No API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
